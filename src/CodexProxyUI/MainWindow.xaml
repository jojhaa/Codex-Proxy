<Window x:Class="CodexProxyUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Proxy"
        Icon="icon.ico"
        Height="660" Width="890"
        MinHeight="660" MinWidth="890"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Source Han Sans SC, Noto Sans SC, PingFang SC, Microsoft YaHei UI, sans-serif">

    <Window.Resources>
        <!-- 主渐变翡翠青绿大按钮 -->
        <Style x:Key="MainActionButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#059669" Offset="0" />
                        <GradientStop Color="#06B6D4" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="0,11">
                            <Border.Effect>
                                <DropShadowEffect Color="#059669" BlurRadius="14" Direction="270" ShadowDepth="2" Opacity="0.35" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要幽灵按钮 -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#334155" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#475569" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 窗口标题栏按钮 (最小化/关闭) -->
        <Style x:Key="WindowCtrlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮 (请求关闭) -->
        <Style x:Key="DangerGhostButton" TargetType="Button">
            <Setter Property="Background" Value="#2D1517" />
            <Setter Property="Foreground" Value="#F87171" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#4C1D24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="14,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4C1D24" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#7F1D1D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1A0A0C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代精细输入框 -->
        <Style x:Key="ModernInputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CaretBrush" Value="#10B981" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="boxBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="boxBorder" Property="BorderBrush" Value="#10B981" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分段式单选按钮样式 -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="segmentBorder" Background="Transparent" CornerRadius="6" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="segmentBorder" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 全局暗黑极简滚动条 (ScrollBar) 样式及依赖项 -->
        <Style TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder" Background="#334155" CornerRadius="4" Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#475569" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#10B981" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="8" />
                                <Setter Property="MinHeight" Value="8" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层主阴影与主容器 -->
    <Border Margin="10" Background="#0B0F19" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" Direction="270" ShadowDepth="6" Opacity="0.65" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" /> <!-- 1. 沉浸式标题栏 -->
                <RowDefinition Height="*" />    <!-- 2. 主内容与设置面板 -->
                <RowDefinition Height="Auto" /> <!-- 3. 底部功能栏 -->
            </Grid.RowDefinitions>

            <!-- 1. 自定义沉浸式标题栏 -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Padding="16,0,12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="icon.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Codex Proxy" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        <Border Margin="8,0,0,0" Padding="6,2" Background="#064E3B" CornerRadius="4" BorderBrush="#059669" BorderThickness="1">
                            <TextBlock Text="SOCKS5h 远端 DNS" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- 窗口按键与设置按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnToggleSettings" Style="{StaticResource WindowCtrlButton}" Click="BtnToggleSettings_Click" ToolTip="进程与 DNS 域名规则设置" Margin="0,0,4,0" Width="36">
                            <TextBlock Text="⚙️" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource WindowCtrlButton}" Click="BtnMinimize_Click" ToolTip="最小化">
                            <TextBlock Text="—" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource WindowCtrlButton}" Click="BtnClose_Click" ToolTip="关闭" Margin="2,0,0,0">
                            <TextBlock Text="✕" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 左右双栏主视图包装区 (左侧控制与指标，右侧全高度日志控制台) -->
            <Grid x:Name="GridMainContent" Grid.Row="1" Margin="16,4,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />     <!-- 左侧控制面板与指标 -->
                    <ColumnDefinition Width="14" />    <!-- 间距 -->
                    <ColumnDefinition Width="340" />   <!-- 右侧全高度实时诊断控制台 -->
                </Grid.ColumnDefinitions>

                <!-- 左侧控制面板布局 -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 2.1 状态看板卡片 -->
                        <Border Margin="0,0,0,10" Background="#111827" CornerRadius="12" BorderBrush="#1F2937" BorderThickness="1" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAppStatusTitle" Text="ChatGPT 客户端未运行" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                                    <TextBlock x:Name="TxtAppStatusSub" Text="使用代理参数启动；实际联网效果需验证" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- 状态微光胶囊 -->
                                <Border Grid.Column="1" x:Name="StatusBadge" VerticalAlignment="Center"
                                        Background="#1F2937" CornerRadius="16" Padding="10,5" BorderBrush="#374151" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#94A3B8" Margin="0,0,6,0" />
                                        <TextBlock x:Name="StatusLabel" Text="空闲就绪" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 2.2 代理配置卡片 -->
                        <Border Margin="0,0,0,10" Background="#111827" CornerRadius="12" BorderBrush="#1F2937" BorderThickness="1" Padding="16,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="RadioStandardMode" Content="标准代理" GroupName="ProxyMode" IsChecked="True" Style="{StaticResource SegmentRadio}" Checked="ProxyMode_Checked" />
                                    <RadioButton x:Name="RadioProcessMode" Content="进程代理" GroupName="ProxyMode" Style="{StaticResource SegmentRadio}" Checked="ProxyMode_Checked" />
                                </StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="代理节点参数配置" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />

                                    <!-- 分段协议选择器 -->
                                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="2" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioSocks5" Content="SOCKS5h" GroupName="Proto" Style="{StaticResource SegmentRadio}" IsChecked="True" Checked="RadioProto_Checked" ToolTip="推荐：包含远端 DNS 解析，解决域名污染" />
                                            <RadioButton x:Name="RadioHttp" Content="HTTP" GroupName="Proto" Style="{StaticResource SegmentRadio}" Margin="2,0,0,0" Checked="RadioProto_Checked" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- IP 与 端口输入 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="代理主机地址 (IP / 域名)" FontSize="10.5" Foreground="#94A3B8" Margin="2,0,0,4" />
                                        <TextBox x:Name="TxtProxyHost" Text="127.0.0.1" Style="{StaticResource ModernInputBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="端口" FontSize="10.5" Foreground="#94A3B8" Margin="2,0,0,4" />
                                        <TextBox x:Name="TxtProxyPort" Text="7890" Style="{StaticResource ModernInputBox}" />
                                    </StackPanel>
                                </Grid>

                                <!-- 远端 DNS 解析设置 -->
                                <CheckBox x:Name="ChkRemoteDns" Content="仅 OpenAI / ChatGPT 名单使用远端 DNS 解析 (SOCKS5h)"
                                          ToolTip="默认包含 openai.com、chatgpt.com、oaistatic.com、oaiusercontent.com 的根域和子域。名单外本地解析，连接仍使用原代理。"
                                          IsChecked="True" IsEnabled="False" Foreground="#34D399" FontSize="11" Margin="0,0,0,10" />

                                <!-- 测速与保存 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtTestResult" Text="TCP 端口待检查" TextWrapping="Wrap" MaxWidth="195" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BtnTestProxy" Content="检查端口" Style="{StaticResource GhostButton}" Click="BtnTestProxy_Click" Margin="0,0,6,0" Padding="10,5" />
                                        <Button x:Name="BtnSaveConfig" Content="保存配置" Style="{StaticResource GhostButton}" Click="BtnSaveConfig_Click" Padding="10,5" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2.3 特性指标 (2x2 小卡片) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="#111827" CornerRadius="8" Padding="10,8" BorderBrush="#1F2937" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="代理作用域" FontSize="10" Foreground="#94A3B8" />
                                    <TextBlock Text="按所选模式启动" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Background="#111827" CornerRadius="8" Padding="10,8" BorderBrush="#1F2937" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="修改系统网络" FontSize="10" Foreground="#94A3B8" />
                                    <TextBlock Text="零改动 · 免 TUN 驱动" FontSize="11.5" FontWeight="SemiBold" Foreground="#34D399" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Background="#111827" CornerRadius="8" Padding="10,8" BorderBrush="#1F2937" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="账号与登录" FontSize="10" Foreground="#94A3B8" />
                                    <TextBlock Text="完整保留 App 凭据" FontSize="11.5" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2" Background="#111827" CornerRadius="8" Padding="10,8" BorderBrush="#1F2937" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="DNS 解析模式" FontSize="10" Foreground="#94A3B8" />
                                    <TextBlock Text="防污染 SOCKS5h 远端" FontSize="11.5" FontWeight="SemiBold" Foreground="#A78BFA" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 2.4 控制操作大按钮 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnLaunch" Grid.Column="0" Content="🚀 启动 ChatGPT 专属代理"
                                    Style="{StaticResource MainActionButton}" Click="BtnLaunch_Click" />
                            <Button x:Name="BtnStop" Grid.Column="2" Content="请求关闭"
                                    Style="{StaticResource DangerGhostButton}" Click="BtnStop_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 右侧全高度诊断控制台 (Column 2) -->
                <Border Grid.Column="2" Background="#070A14" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 日志 Header -->
                        <Border Grid.Row="0" Background="#0F172A" Padding="10,0" CornerRadius="9,9,0,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#6366F1" Margin="0,0,6,0" />
                                    <TextBlock Text="实时进程控制台 (Live Logs)" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="清空" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="9.5" Click="BtnClearLog_Click" Margin="0,0,4,0" />
                                    <Button Content="复制" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="9.5" Click="BtnCopyLog_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 日志输出框 -->
                        <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Padding="8">
                            <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                     IsReadOnly="True" TextWrapping="Wrap" FontSize="10.5" FontFamily="Cascadia Code, Consolas, monospace" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 设置页面面板 (隐藏/显示，全覆盖主 Grid.Row="1") -->
            <Grid x:Name="GridSettings" Grid.Row="1" Margin="16,4,16,8" Visibility="Collapsed">
                <Border Background="#111827" CornerRadius="12" BorderBrush="#1F2937" BorderThickness="1" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️ 进程与 DNS 域名规则设置中心" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="← 返回主界面" Style="{StaticResource GhostButton}" Click="BtnBackToMain_Click" Padding="8,4" />
                            </Grid>

                            <!-- 1. 系统协同与辅助配置 -->
                            <TextBlock Text="📌 系统辅助与快捷操作" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,4,0,8" />
                            <Border Background="#0F172A" CornerRadius="8" Padding="12,10" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkAutoStart" Content="开机自动启动 (Run 键值)" Foreground="#CBD5E1" FontSize="11.5"
                                                  VerticalAlignment="Center" Click="ChkAutoStart_Click" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="📌 生成桌面图标" Style="{StaticResource GhostButton}"
                                                FontSize="10.5" Padding="8,4" Click="BtnCreateShortcut_Click" Margin="0,0,6,0" />
                                        <Button Content="📁 配置文件" Style="{StaticResource GhostButton}"
                                                FontSize="10.5" Padding="8,4" Click="BtnOpenConfig_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2. 进程设置 -->
                            <TextBlock Text="🛠️ 托管进程与环境变量配置" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" Margin="0,4,0,8" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="主应用安装/启动路径" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton x:Name="RadioPathAuto" Content="⚡ 自动获取" GroupName="PathMode" Style="{StaticResource SegmentRadio}" IsChecked="True" Checked="RadioPathMode_Checked" ToolTip="自动通过系统注册表与 AUMID 搜寻匹配路径" />
                                    <RadioButton x:Name="RadioPathManual" Content="📁 手动指定" GroupName="PathMode" Style="{StaticResource SegmentRadio}" Margin="4,0,0,0" Checked="RadioPathMode_Checked" ToolTip="手动选择任意本地 exe 路径" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtTargetAppPath" Text="OpenAI.Codex_2p2nqsd0c76g0!App" Style="{StaticResource ModernInputBox}" IsReadOnly="True" />
                                <Button x:Name="BtnAutoDetectPath" Grid.Column="2" Content="🔍 自动探测" Style="{StaticResource GhostButton}" Click="BtnAutoDetectPath_Click" Padding="8,4" />
                                <Button x:Name="BtnBrowseAppPath" Grid.Column="2" Content="📁 浏览..." Style="{StaticResource GhostButton}" Click="BtnBrowseAppPath_Click" Padding="8,4" Visibility="Collapsed" />
                            </Grid>

                            <TextBlock Text="自动继承代理的衍生子进程白名单 (分号分隔)" FontSize="10.5" Foreground="#94A3B8" Margin="2,0,0,4" />
                            <TextBox x:Name="TxtSubProcesses" Text="codex.exe; node.exe; electron.exe" Style="{StaticResource ModernInputBox}" Margin="0,0,0,14" />

                            <!-- 3. DNS 域名设置 -->
                            <TextBlock Text="🌐 SOCKS5h 远端 DNS 解析匹配域名名单 (分号分隔)" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,4,0,8" />
                            <TextBox x:Name="TxtRemoteDnsDomains"
                                     Style="{StaticResource ModernInputBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="68" Margin="0,0,0,10" />

                            <TextBlock Text="Bypass 本地直连与豁免白名单 (分号分隔)" FontSize="10.5" Foreground="#94A3B8" Margin="2,0,0,4" />
                            <TextBox x:Name="TxtBypassRules" Text="&lt;-loopback&gt;; localhost; 127.0.0.1; ::1" Style="{StaticResource ModernInputBox}" Margin="0,0,0,14" />

                            <!-- 4. 关于本项目与版本服务 -->
                            <TextBlock Text="ℹ️ 关于本项目与版本服务" FontSize="12" FontWeight="SemiBold" Foreground="#A78BFA" Margin="0,4,0,8" />
                            <Border Background="#0F172A" CornerRadius="8" Padding="12,10" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Codex Proxy" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" />
                                            <TextBlock Text=" v1.0.6" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" Margin="4,0,0,0" />
                                            <TextBlock Text=" (by Time Silent)" FontSize="11" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="TxtUpdateStatus" Text="零驱动 · 进程精准代理 · SOCKS5h 防污染远端 DNS" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnCheckUpdate" Content="🔄 检查更新" Style="{StaticResource GhostButton}"
                                                FontSize="10.5" Padding="8,4" Click="BtnCheckUpdate_Click" Margin="0,0,6,0" />
                                        <Button x:Name="BtnOpenGithub" Content="🔗 GitHub 仓库" Style="{StaticResource GhostButton}"
                                                FontSize="10.5" Padding="8,4" Click="BtnOpenGithub_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 保存设置按钮 -->
                            <Button x:Name="BtnSaveAdvancedSettings" Content="💾 保存进程、DNS 及系统设置" Style="{StaticResource MainActionButton}" Click="BtnSaveAdvancedSettings_Click" Padding="0,10" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 3. 底部精简 Footer 状态栏 -->
            <Border Grid.Row="2" Background="#0F172A" CornerRadius="0,0,16,16" Padding="16,8" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="作者：Time Silent    版本号：v1.0.6" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="⚙️ 高级设置中心" Style="{StaticResource GhostButton}"
                                FontSize="10.5" Padding="10,3" Click="BtnToggleSettings_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
