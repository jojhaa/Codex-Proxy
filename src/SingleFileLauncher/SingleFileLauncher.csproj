<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.11</Version>
    <AssemblyName>ProcWeaver-SingleFile</AssemblyName>
    <ApplicationIcon>../../ui/src-tauri/icons/icon.ico</ApplicationIcon>
    <Copyright>Copyright (c) 2026 Time Silent. GPL-3.0-only.</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="ProcWeaver.Payload.zip" />
  </ItemGroup>
  <Target Name="RequirePayload" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PayloadPath)' == '' Or !Exists('$(PayloadPath)')" Text="请通过 -p:PayloadPath=完整便携ZIP路径 指定载荷。" />
  </Target>
</Project>
